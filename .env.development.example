# Finances API port. Vite proxies /api to this port; choose a free port if needed.
PORT=3002

# auth-service base URL (Vite proxies /auth here with credentials included)
# Dev: the auth-service's dev Cloud Run URL (see auth-service README for the current one).
# VITE_AUTH_BASE_URL=https://auth-dev-46917854791.us-central1.run.app

# Leave VITE_API_BASE_URL unset in dev to use the same-origin Vite proxy.

# Neon Postgres connection (server); must match auth-service's NEON_URI_FINANCES.
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# Must match auth-service's JWT_SECRET and AUTH_COOKIE_NAME exactly — finances-api only
# verifies the token auth-service issues, it never signs its own.
# Must match auth-service's JWT_SECRET and AUTH_COOKIE_NAME exactly — finances-api only
# verifies the token auth-service issues, it never signs its own.
JWT_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=auth_session
